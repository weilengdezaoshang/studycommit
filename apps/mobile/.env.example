# 复制为 .env 后重启 Expo。EXPO_PUBLIC_* 会进入客户端，只能放公开地址。
# iOS 模拟器可用 localhost；Android 模拟器改为 http://10.0.2.2:3000；真机用电脑局域网 IP。
EXPO_PUBLIC_STUDYCOMMIT_API_ORIGIN=http://localhost:3000
EXPO_PUBLIC_STUDYCOMMIT_API_PREFIX=/api

# 仅本地开发使用，不要写成 EXPO_PUBLIC_*
STUDYCOMMIT_DEV_USER_ID=11111111-1111-4111-8111-111111111111
