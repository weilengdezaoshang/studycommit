{
  "name": "@studycommit/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "contracts:build": "pnpm --filter @studycommit/rpc-contracts build",
    "predev": "pnpm --filter @studycommit/rpc-contracts build",
    "dev": "tsx watch --include ../../packages/rpc-contracts/dist/**/*.js src/main.ts",
    "start": "node dist/main.js",
    "prebuild": "pnpm --filter @studycommit/rpc-contracts build",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/database/migrate.ts",
    "test": "pnpm run contracts:build && vitest run",
    "test:run": "pnpm run contracts:build && vitest run --project unit",
    "test:unit": "pnpm run contracts:build && vitest run --project unit",
    "test:integration": "pnpm run contracts:build && vitest run --project integration",
    "test:e2e": "pnpm run contracts:build && vitest run --project e2e"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "@nestjs/common": "^11.1.29",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.29",
    "@nestjs/platform-fastify": "^11.1.29",
    "@nestjs/swagger": "^11.4.6",
    "@orpc/nest": "^1.15.0",
    "@orpc/openapi": "^1.15.0",
    "@orpc/server": "^1.15.0",
    "@orpc/zod": "^1.15.0",
    "@studycommit/rpc-contracts": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.11.0",
    "ioredis": "^6.0.0",
    "nestjs-pino": "^4.6.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.29",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10"
  }
}
