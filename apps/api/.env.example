# StudyCommit API 环境示例:复制为 .env(开发)或 .env.test(测试)后按需修改。

NODE_ENV=development
API_PORT=3000
DATABASE_URL=postgresql://studycommit:studycommit@localhost:5432/studycommit
REDIS_URL=redis://localhost:6379

# 验证码与微信登录联调桩(生产禁止使用)
# AUTH_OTP_STUB=123456
# AUTH_WECHAT_STUB=1
# WECHAT_MINI_APP_ID=
# WECHAT_MINI_APP_SECRET=

# 令牌有效期
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=2592000

# AI 私人配置请放在 ~/.config/studycommit/api.env（不在项目工作区中）。
# 也可通过 STUDYCOMMIT_CONFIG_FILE 指定绝对路径；进程环境变量优先级最高。
#
# 平台服务商密钥改由管理后台配置并加密入库。未建立数据库配置时,仍兼容下列环境变量。
# 后台显式停用后不会自动回退到环境变量。不要把客户端已有真实密钥自动上传到后台。
# openai    -> OpenAI 兼容协议(GLM/Qwen/DeepSeek/OpenAI),默认 https://api.openai.com/v1
# anthropic -> Anthropic Messages 协议(Claude),        默认 https://api.anthropic.com
# gemini    -> Google generateContent 协议(Gemini),     默认 https://generativelanguage.googleapis.com
AI_PROTOCOL=openai
AI_API_KEY=
AI_MODEL=
# 可选:自建网关或代理端点;留空使用上方协议默认端点
# AI_BASE_URL=
# 可选:请求超时(毫秒),默认 15000
# AI_TIMEOUT_MS=15000
#
# 服务商 API Key 加密主密钥:32 字节,64 位 hex 或标准 base64。
# 不入库、不入 Git、不能通过后台设置。缺少该值时拒绝写入密钥,不会降级明文保存。
# 生成示例: openssl rand -hex 32
# AI_PROVIDER_ENCRYPTION_KEY=
# 仅当需要访问本地代理时填写,逗号分隔完整源,例如 http://127.0.0.1:11434
# AI_PROVIDER_TRUSTED_BASE_URLS=
