<view class="page" style="padding-top:{{statusBarHeight}}px">
<custom-navigation title="{{title}}" height="{{navigationBarHeight}}" reserve-capsule bind:back="back" />
<text wx:if="{{preview}}" class="hint">设计预览 · 示例素材与状态</text>
<scroll-view scroll-y class="content">
<block wx:if="{{state.page === 'preview'}}">
  <view class="row"><text>已添加 {{state.images.length}} 张 · 最多 9 张</text><notebook-button label="排序" secondary disabled="{{!state.images.length}}" bind:press="sort" /></view>
  <notebook-sheet><view wx:if="{{currentUri}}" class="preview-photo"><image class="large" src="{{currentUri}}" mode="aspectFit" /><text class="image-count">{{state.selected + 1}} / {{state.images.length}}</text></view><view wx:else class="empty"><text class="heading">把这一刻记下来</text><text>拍照或从相册选择图片</text></view></notebook-sheet>
  <view class="row"><notebook-button label="重新裁剪" secondary disabled="{{!state.images.length}}" bind:press="crop" /><notebook-button label="删除" secondary disabled="{{!state.images.length}}" bind:press="removeCurrent" /></view>
  <capture-image-strip images="{{state.images}}" selected="{{state.selected}}" bind:select="select" />
  <view class="row equal-actions"><notebook-button label="继续拍摄" loading="{{picking}}" disabled="{{state.images.length >= 9}}" bind:press="camera" /><notebook-button label="相册添加" disabled="{{picking || state.images.length >= 9}}" bind:press="album" /></view>
  <notebook-button label="{{state.mode === 'ocr' ? '识别文字' : '进入编辑'}}（{{state.images.length}} 张）" disabled="{{!state.images.length}}" bind:press="proceed" />
</block>
<block wx:elif="{{state.page === 'sort'}}"><text class="hint">上下拖动图片调整顺序，也可以点击箭头；文字和附件按此顺序排列</text><notebook-sheet wx:for="{{rows}}" wx:key="id"><view class="row" data-id="{{item.id}}" bindtouchstart="sortTouchStart" bindtouchend="sortTouchEnd"><image class="thumb" src="{{item.uri}}" mode="aspectFill" /><text>第 {{index + 1}} 张</text><notebook-button label="上移" disabled="{{index === 0}}" data-id="{{item.id}}" data-delta="-1" bind:press="move" /><notebook-button label="下移" disabled="{{index === rows.length - 1}}" data-id="{{item.id}}" data-delta="1" bind:press="move" /></view></notebook-sheet><notebook-button label="完成" bind:press="previewImages" /></block>
<block wx:elif="{{state.page === 'recognition'}}"><capture-progress title="{{summary.title}}" rows="{{rows}}" completed="{{summary.done}}" bind:retry="retry" /><notebook-button wx:if="{{!summary.working}}" label="{{summary.done ? '使用已有文字' : '作为图片记录'}}" bind:press="edit" /><notebook-button label="{{summary.working ? '取消识别' : '返回图片预览'}}" secondary bind:press="previewImages" /></block>
<block wx:elif="{{state.page === 'editor'}}"><view class="row"><text>{{state.images.length}} 张图片 · 尚未保存</text><notebook-button label="保存" disabled="{{!summary.canSave}}" bind:press="save" /></view><notebook-sheet><textarea class="editor" value="{{state.content}}" maxlength="-1" placeholder="补充说明（可选）" cursor-spacing="80" bindinput="content" /></notebook-sheet><text class="hint">原图 · {{state.images.length}} 张</text><capture-image-strip images="{{state.images}}" selected="{{state.selected}}" removable bind:select="select" bind:remove="remove" /><view class="row"><notebook-button label="添加图片" secondary bind:press="openSource" /><notebook-button label="{{state.question ? '取消问题标记' : '标记问题'}}" secondary bind:press="question" /></view><text class="hint">移除图片不会删除文字 · 缺失图片请移除后重新选择</text></block>
<block wx:elif="{{state.page === 'saving'}}"><notebook-sheet><text>{{state.content}}</text><capture-image-strip images="{{state.images}}" selected="{{state.selected}}" bind:select="select" /></notebook-sheet><text class="heading">{{state.error ? '保存未完成' : '正在保存'}}</text><text>已上传 {{state.saveCompleted}} / {{rows.length}} 张</text><view wx:for="{{rows}}" wx:key="id" class="notice">第 {{index + 1}} 张 · {{item.label}}</view><notebook-button wx:if="{{state.error}}" label="重试保存" bind:press="save" /><notebook-button label="返回编辑" secondary bind:press="edit" /></block>
<block wx:elif="{{state.page === 'permission'}}"><view class="empty"><text class="heading">还不能使用相机</text><text>请在设置中开启相机权限</text></view><notebook-button label="去设置" bind:press="settings" /><notebook-button label="从相册选择" secondary bind:press="album" /></block>
<block wx:elif="{{state.page === 'list'}}"><notebook-sheet><text class="heading">15 · 9月 周二</text><text class="hint">11:08 · 待整理</text><capture-image-strip images="{{state.images}}" selected="{{state.selected}}" bind:select="select" /><text>共 {{state.images.length}} 张图片</text><notebook-button label="打开记录" secondary bind:press="detail" /></notebook-sheet></block>
<block wx:elif="{{state.page === 'detail' || state.page === 'viewer'}}"><text class="hint">图片 · {{rows.length}} 张</text><text wx:if="{{state.page === 'detail'}}">{{state.content}}</text><notebook-sheet wx:for="{{rows}}" wx:key="id"><image class="large" src="{{item.uri}}" mode="aspectFit" data-index="{{index}}" bindtap="view" /><notebook-button label="查看第 {{index + 1}} 张" secondary data-index="{{index}}" bind:press="view" /></notebook-sheet></block>
</scroll-view><view wx:if="{{state.error}}" class="notice" role="alert">{{state.error}}</view>
<view wx:if="{{sourceOpen || state.recovery}}" class="overlay {{!state.recovery ? 'source-overlay' : ''}}"><notebook-sheet><block wx:if="{{state.recovery}}"><text class="heading">继续上次的记录？</text><text>还有一份未完成的草稿</text><capture-image-strip images="{{state.images}}" selected="{{state.selected}}" bind:select="select" /><notebook-button label="继续编辑" bind:press="recover" /><notebook-button label="丢弃后新建" secondary bind:press="discard" /></block><block wx:else><text class="heading">添加图片</text><view class="row equal-actions"><notebook-button label="拍照" bind:press="camera" /><notebook-button label="从相册选择" bind:press="album" /></view><notebook-button label="取消" secondary bind:press="closeSource" /></block></notebook-sheet></view></view>
