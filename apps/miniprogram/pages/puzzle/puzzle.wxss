.page{min-height:100vh;padding:36rpx;background:#f6f8f5;color:#33413f;box-sizing:border-box}.state{display:grid;gap:24rpx;padding:100rpx 20rpx;text-align:center}.gallery,.album{display:grid;gap:24rpx}.kicker,small,.hint{color:#71807d;font-size:22rpx}.art-card{display:flex;gap:20rpx;padding:16rpx;border:1rpx solid #cbd5d2;border-radius:24rpx;background:#fffdf8;text-align:left}.art-card image{width:180rpx;height:135rpx;border-radius:16rpx}.art-card view{display:grid;align-content:center;gap:10rpx}.heading{display:flex;align-items:end;justify-content:space-between}.heading view{display:grid;gap:8rpx}.title{font-size:40rpx;font-weight:600}.picture{position:relative;overflow:hidden;aspect-ratio:4/3;border:12rpx solid #fffdf8;border-radius:24rpx;box-shadow:0 12rpx 34rpx rgba(50,65,60,.1)}.picture image{width:100%;height:100%}.mask{position:absolute;inset:0;background:#fffdf8;pointer-events:none}.scratch{width:600rpx;height:440rpx;margin-top:-488rpx;z-index:2}.hint{text-align:center}.primary{background:#496d68;color:white}
.organize{display:grid;gap:24rpx}.paper{min-height:220rpx;padding:34rpx;border:1rpx solid #cbd5d2;border-radius:24rpx;background:#fffdf8;line-height:1.8}.picker{padding:24rpx;border-bottom:1rpx solid #9eb0ac}.actions{display:flex;gap:16rpx}.actions button{flex:1}
