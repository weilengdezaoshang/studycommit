.editor-page {
  min-height: 100vh;
  padding: 32rpx;
  background: var(--sc-canvas);
}

.note-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 520rpx;
  padding: 32rpx;
  border: 1rpx solid var(--sc-line);
  border-radius: 20rpx;
  background: var(--sc-paper);
  color: var(--sc-ink);
  font-size: 32rpx;
  line-height: 1.7;
}

.editor-footer {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.save-button {
  flex: 1;
  border-radius: 16rpx;
  font-size: 28rpx;
}

.save-button {
  background: var(--sc-action);
  color: var(--sc-paper);
}
