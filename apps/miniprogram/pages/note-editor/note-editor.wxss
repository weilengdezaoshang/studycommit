.editor-page {
  min-height: 100vh;
  padding: 32rpx;
  background: #f8f6ef;
}

.note-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 520rpx;
  padding: 32rpx;
  border: 1rpx solid #dedbcc;
  border-radius: 20rpx;
  background: #fffdf7;
  color: #24251f;
  font-size: 32rpx;
  line-height: 1.7;
}

.editor-footer {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.question-button,
.save-button {
  flex: 1;
  border-radius: 16rpx;
  font-size: 28rpx;
}

.question-button {
  border: 1rpx solid #c6c5b9;
  background: transparent;
  color: #55574e;
}

.save-button {
  background: #68765f;
  color: #fffdf7;
}
