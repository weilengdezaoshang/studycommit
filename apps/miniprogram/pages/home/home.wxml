<view class="home-page" style="padding-top: {{statusBarHeight}}px;">
  <view class="topbar">
    <view class="icon-button menu-button" role="button" aria-label="打开学习抽屉" bindtap="openDrawer">
      <image class="menu-image" src="/assets/icons/menu.svg" mode="aspectFit" />
    </view>
    <text class="month-title">{{monthTitle}}</text>
    <view class="topbar-spacer"></view>
  </view>

  <view class="week-strip">
    <view class="week-days">
      <block wx:for="{{weekDays}}" wx:key="dateKey">
        <button class="week-day {{item.isSelected ? 'is-selected' : ''}}" data-date="{{item.dateKey}}" bindtap="selectDate" hover-class="none" aria-label="{{item.dateKey}}，{{item.paperCount}} 张纸页">
          <text class="day-label">{{item.isToday ? '今天' : item.dayLabel}}</text>
          <view class="paper-stack {{item.paperCount ? '' : 'is-empty'}}">
            <block wx:for="{{item.stack}}" wx:key="*this"><view class="stack-paper"></view></block>
            <text wx:if="{{item.hasMore}}" class="stack-more">3+</text>
          </view>
        </button>
      </block>
    </view>
  </view>

  <view wx:if="{{isLoading}}" class="state-card"><text>正在取回你的纸页……</text></view>
  <view wx:elif="{{isLoadError}}" class="state-card state-card-error">
    <text>暂时取不回你的学习内容</text>
    <small>{{loadErrorMessage}}</small>
    <button class="secondary-button" bindtap="retryLoad">重新加载</button>
  </view>
  <view wx:elif="{{timelinePapers.length}}" class="timeline-list {{isTimelineSwapping ? 'timeline-swap' : ''}}">
    <block wx:for="{{timelinePapers}}" wx:key="id">
      <view class="timeline-entry">
        <view class="timeline-rail"><view class="timeline-dot"></view><text>{{item.timeLabel}}</text></view>
        <view class="paper-card {{item.templateClass}}" data-id="{{item.id}}" bindtap="openPaper" hover-class="paper-card-pressed" hover-start-time="0" hover-stay-time="80">
          <text class="paper-content">{{item.content}}</text>
          <view class="paper-meta"><text class="paper-label">{{item.topicLabel}}</text><text wx:if="{{item.hasQuestion && !item.isQuestionResolved}}" class="agent-hint">继续弄懂</text></view>
        </view>
      </view>
    </block>
  </view>
  <view wx:elif="{{!isLoading}}" class="empty-day">
    <text class="empty-title">这天还没有纸页</text><text class="empty-copy">空白只是留白，不是中断。</text>
    <button class="secondary-button" bindtap="startWriting">写下第一张</button>
  </view>

  <button class="fab" aria-label="记下一张纸页" bindtap="startWriting"><text>+</text></button>

  <view wx:if="{{isDrawerOpen}}" class="scrim" catchtap="closeDrawer"></view>
  <view class="drawer drawer-v2 {{isDrawerOpen ? 'drawer-open' : ''}}" aria-label="个人学习抽屉">
    <view class="drawer-profile">
      <view class="drawer-profile-main"><view class="avatar">hi</view><text class="profile-name">我的学习</text></view>
      <view class="drawer-profile-actions">
        <button class="drawer-icon-button" aria-label="搜索纸页与主题" bindtap="openSearch"><image class="drawer-action-icon" src="/assets/icons/search.svg" mode="aspectFit" /></button>
        <button class="drawer-icon-button drawer-close" aria-label="关闭学习抽屉" bindtap="closeDrawer"><image class="drawer-action-icon" src="/assets/icons/close.svg" mode="aspectFit" /></button>
      </view>
    </view>

    <view class="drawer-calendar">
      <view class="review-entry" role="button" aria-label="查看月份装订" bindtap="openReview"><view class="review-month">{{monthDisplayLabel}}</view><view class="review-binding">查看装订 ›</view></view>
      <view class="calendar-weekdays"><text wx:for="{{['一','二','三','四','五','六','日']}}" wx:key="*this">{{item}}</text></view>
      <view class="calendar-grid">
        <block wx:for="{{monthDays}}" wx:key="dateKey">
          <view wx:if="{{item.isBlank}}" class="calendar-day is-blank"></view>
          <button wx:else class="calendar-day level-{{item.level}} {{item.isSelected ? 'is-selected' : ''}}" data-date="{{item.dateKey}}" bindtap="selectDate" hover-class="none" aria-label="{{item.dateKey}}，{{item.paperCount}} 张纸页"><image wx:if="{{item.paperCount}}" class="calendar-paper-icon" src="/assets/icons/paper.svg" mode="aspectFit" /><view wx:else class="calendar-dot"></view></button>
        </block>
      </view>
      <view class="heat-legend">
        <text>少</text>
        <image class="heat-legend-icon heat-legend-dot" src="/assets/icons/calendar-dot.svg" mode="aspectFit" />
        <image class="heat-legend-icon heat-legend-paper" src="/assets/icons/paper.svg" mode="aspectFit" />
        <image class="heat-legend-icon heat-legend-stack-2" src="/assets/icons/paper-stack-2.svg" mode="aspectFit" />
        <image class="heat-legend-icon heat-legend-stack-3" src="/assets/icons/paper-stack-3.svg" mode="aspectFit" />
        <text>多</text>
      </view>
    </view>

    <view class="drawer-section drawer-topics-section">
      <view class="drawer-section-heading"><text>我的箱子</text><button class="add-topic-button" aria-label="快速新建未命名箱子" disabled="{{isCreatingTopic}}" bindtap="createDefaultTopic"><text>+</text></button></view>
      <view wx:if="{{isTopicFormOpen}}" class="topic-form">
        <input class="topic-input" maxlength="80" value="{{newTopicName}}" placeholder="主题名称" bindinput="onTopicNameInput" confirm-type="done" bindconfirm="createTopic" />
        <button class="topic-submit" loading="{{isCreatingTopic}}" bindtap="createTopic">创建</button>
      </view>
      <view wx:if="{{!topics.length}}" class="topic-empty">
        <text>还没有箱子</text>
        <small>创建一个箱子，开始整理纸页。</small>
        <button class="topic-empty-button" bindtap="toggleTopicForm">新建箱子</button>
      </view>
      <view wx:else class="topic-list"><block wx:for="{{visibleTopics}}" wx:key="id"><button class="topic-row {{item.isSelected ? 'is-selected' : ''}}" data-id="{{item.id}}" bindtap="selectTopic" aria-label="{{item.name}}，{{item.paperCountLabel}} 张纸页"><image class="topic-box-icon" src="/assets/icons/box.svg" mode="aspectFit" /><text>{{item.name}}</text><small>{{item.paperCountLabel}}</small></button></block></view>
      <button wx:if="{{hasMoreTopics}}" class="topic-overflow-button" bindtap="openTopics">{{topicOverflowLabel}}</button>
    </view>

    <view class="drawer-section drawer-attention-section">
      <view class="drawer-section-heading attention-heading"><text>需要留意</text></view>
      <button class="drawer-row {{inboxCount ? 'has-attention' : ''}}" bindtap="showInbox"><image class="attention-icon" src="/assets/icons/inbox.svg" mode="aspectFit" /><text>待整理的纸页</text><small>{{inboxCountLabel}}</small></button>
      <button class="drawer-row" bindtap="openProblems"><image class="attention-icon" src="/assets/icons/review.svg" mode="aspectFit" /><text>还在思考的问题</text><small>{{problemCountLabel}}</small></button>
    </view>
  </view>

  <view wx:if="{{isTopicsOpen}}" class="overlay-panel topics-panel">
    <view class="overlay-header"><button class="back-button" aria-label="关闭主题列表" bindtap="closeTopics">‹</button><text class="overlay-title">全部箱子</text><view class="header-spacer"></view></view>
    <view wx:if="{{topics.length}}" class="topics-panel-list">
      <block wx:for="{{topics}}" wx:key="id">
        <button class="topics-panel-row {{item.isSelected ? 'is-selected' : ''}}" data-id="{{item.id}}" bindtap="selectTopic" aria-label="{{item.name}}，{{item.paperCountLabel}} 张纸页">
          <image class="topics-panel-icon" src="/assets/icons/box.svg" mode="aspectFit" />
          <text>{{item.name}}</text>
          <small>{{item.paperCountLabel}}</small>
        </button>
      </block>
    </view>
    <view wx:else class="overlay-empty"><text>还没有箱子</text><small>返回抽屉创建第一个箱子。</small></view>
  </view>

  <view wx:if="{{isSearchOpen}}" class="overlay-panel search-panel">
    <view class="overlay-header"><button class="back-button" aria-label="关闭搜索" bindtap="closeSearch">‹</button><input class="search-input" focus="{{isSearchOpen}}" value="{{searchQuery}}" placeholder="搜索纸页与主题" bindinput="onSearchInput" /><button class="clear-button" wx:if="{{searchQuery}}" bindtap="closeSearch">×</button></view>
    <text wx:if="{{!searchQuery}}" class="overlay-hint">输入关键词，找回过去的记录</text>
    <view wx:elif="{{searchResults.length}}" class="search-results"><block wx:for="{{searchResults}}" wx:key="id"><button class="search-result" data-type="{{item.type}}" data-id="{{item.id}}" bindtap="selectSearchResult"><text class="result-title">{{item.title}}</text><text class="result-detail">{{item.detail}}</text></button></block></view>
    <view wx:else class="overlay-empty"><text>没有找到相关内容</text></view>
  </view>

  <view wx:if="{{isReviewOpen}}" class="overlay-panel review-panel">
    <view class="overlay-header"><button class="back-button" aria-label="关闭月份回顾" bindtap="closeReview">‹</button><text class="overlay-title">{{monthLabel}}装订</text><view class="header-spacer"></view></view>
    <view class="bound-book"><text class="book-kicker">AUGUST · 2026</text><text class="book-title">学习装订</text><text class="book-copy">理解不是一次完成的，它在记录、整理与追问之间慢慢变厚。</text></view>
    <view class="review-stats"><view><text>{{paperCount}}</text><small>纸页</small></view><view><text>{{topicCount}}</text><small>主题</small></view><view><text>{{inboxCount}}</text><small>待整理</small></view></view>
  </view>

  <view wx:if="{{isProblemsOpen}}" class="overlay-panel problems-panel">
    <view class="overlay-header"><button class="back-button" aria-label="关闭问题" bindtap="closeProblems">‹</button><text class="overlay-title">还在思考的问题</text><view class="header-spacer"></view></view>
    <view class="overlay-empty"><text>当前契约还没有问题字段</text><small>先把纸页放入待整理，问题标记将在下一版接入。</small></view>
  </view>

  <view wx:if="{{isDetailOpen && selectedPaper}}" class="detail-panel" style="padding-top: {{statusBarHeight}}px;">
    <view class="detail-bar">
      <button class="detail-back-button" aria-label="关闭纸页详情" bindtap="closePaper">‹</button>
      <text class="detail-bar-title">纸页</text>
      <view class="detail-bar-spacer"></view>
    </view>
    <view class="detail-paper {{selectedPaper.templateClass}}">
      <view class="detail-meta"><text class="detail-time">{{selectedPaper.dateLabel}} · {{selectedPaper.timeLabel}}</text><text wx:if="{{selectedPaper.hasQuestion}}" class="detail-state">{{selectedPaper.isQuestionResolved ? '已解决' : '还在思考'}}</text></view>
      <text class="detail-topic">{{selectedPaper.topicLabel}}</text>
      <text class="detail-content">{{selectedPaper.content}}</text>
    </view>
    <view class="detail-actions">
      <button wx:if="{{selectedPaper.hasQuestion && !selectedPaper.isQuestionResolved}}" class="understand-button" bindtap="openAgent">继续弄懂</button>
      <button class="detail-action-button" bindtap="openDetailManage">整理</button>
    </view>

    <view wx:if="{{isDetailManageOpen}}" class="detail-manage-scrim" catchtap="closeDetailManage"></view>
    <view wx:if="{{isDetailManageOpen}}" class="detail-manage-sheet" catchtap="keepDetailManageOpen">
      <view class="detail-manage-head"><text>{{isTopicChoicesOpen ? '选择箱子' : '整理纸页'}}</text><button aria-label="关闭整理面板" bindtap="closeDetailManage">关闭</button></view>
      <view wx:if="{{!isTopicChoicesOpen}}">
        <button class="manage-action" bindtap="openTopicChoices"><text>归入箱子</text><small>把这张纸页放进一个主题</small></button>
        <button wx:if="{{selectedPaper.hasQuestion && !selectedPaper.isQuestionResolved}}" class="manage-action" bindtap="resolveQuestion"><text>标记已经解决</text><small>问题不是任务，解决后仍保留原纸页</small></button>
      </view>
      <view wx:else class="detail-box-choices"><block wx:for="{{topics}}" wx:key="id"><button class="detail-box-choice" data-id="{{item.id}}" bindtap="selectDetailTopic"><text>{{item.name}}</text><small>{{item.paperCount}} 张纸页</small></button></block></view>
    </view>
  </view>

  <view wx:if="{{isAgentOpen && selectedPaper}}" class="agent-panel" style="padding-top: {{statusBarHeight}}px;">
    <view class="agent-bar"><button class="agent-back-button" aria-label="返回纸页详情" bindtap="closeAgent">‹</button><text>继续弄懂</text><button class="agent-exit-button" bindtap="closeAgent">结束</button></view>
    <view class="agent-context"><text class="agent-context-topic">{{selectedPaper.topicLabel}}</text><text class="agent-context-source">{{selectedPaper.content}}</text></view>
    <view class="agent-body">
      <view class="explain-deck">
        <view class="explain-card" style="transform: {{agentTransform}}; opacity: {{agentOpacity}};" bindtouchstart="onAgentTouchStart" bindtouchmove="onAgentTouchMove" bindtouchend="onAgentTouchEnd" bindtouchcancel="onAgentTouchEnd">
          <text class="agent-card-step">AI 解释 · {{agentStepLabel}}</text>
          <text class="explain-card-title">{{agentCardTitle}}</text>
          <text class="explain-card-body">{{agentCardBody}}</text>
          <text class="explain-card-example">{{agentCardExample}}</text>
        </view>
      </view>
      <view class="swipe-guide"><text>← 不理解</text><text>理解了 →</text></view>
    </view>
  </view>
</view>
