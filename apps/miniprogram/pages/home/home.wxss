/* 首页与抽屉样式。所有颜色优先走 tokens.wxss 的 --sc-* 变量，
   固定定位层保留字面量兜底，兼容未解析 CSS 变量的基础库。 */

/* ---------- 页面基础 ---------- */

.home-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 var(--sc-page-gutter, 32rpx) calc(152rpx + env(safe-area-inset-bottom));
  background-color: #fffef9;
  background-color: var(--sc-paper, #fffef9);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Hiragino Sans GB', sans-serif;
}

/* ---------- 周历条 ---------- */

.week-strip {
  width: 100%;
}

.week-days {
  display: flex;
  width: 100%;
  justify-content: space-between;
  padding: 2rpx 0 16rpx;
  border-bottom: 1rpx solid var(--sc-line);
}

.week-day {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  min-width: 0;
  margin: 0 1rpx;
  min-height: 92rpx;
  box-sizing: border-box;
  padding: 8rpx 0 4rpx;
  border-radius: 14rpx;
  background: transparent;
  color: var(--sc-muted);
}

.week-day.is-selected {
  background-color: var(--sc-selected-surface);
  color: var(--sc-ink);
}

.week-day.is-selected::after {
  content: '';
  width: 32rpx;
  height: 3rpx;
  margin-top: auto;
  border-radius: 3rpx;
  background: var(--sc-action);
}

.day-label {
  font-size: 22rpx;
  font-weight: 500;
}

.week-paper-visual {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 48rpx;
  margin-top: 6rpx;
}

.week-paper-icon {
  display: block;
  width: 48rpx;
  height: 52rpx;
}

.week-paper-single {
  width: 38rpx;
  height: 44rpx;
}

.week-paper-stack-2 {
  width: 44rpx;
  height: 48rpx;
}

.week-paper-stack-3 {
  width: 48rpx;
  height: 52rpx;
}

.week-paper-empty {
  display: block;
  width: 8rpx;
  height: 8rpx;
}

.stack-more {
  position: absolute;
  top: -2rpx;
  right: -6rpx;
  min-width: 28rpx;
  height: 28rpx;
  border-radius: 14rpx;
  background: var(--sc-ink);
  color: var(--sc-paper);
  font-size: 16rpx;
  line-height: 28rpx;
  text-align: center;
}

/* ---------- 周汇总 ---------- */

.week-summary {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 18rpx 0 20rpx;
}

.week-summary-label {
  color: var(--sc-ink);
  font-size: 30rpx;
  font-weight: 500;
}

.week-summary-value {
  color: var(--sc-muted);
  font-size: 22rpx;
}

/* ---------- 时间线与纸页卡片 ---------- */.timeline-list {
  position: relative;
  margin-top: 24rpx;
  margin-left: 20rpx;
}

.timeline-swap {
  animation: timeline-swap 0.2s cubic-bezier(0.16, 1, 0.3, 1);
}

@keyframes timeline-swap {
  from {
    transform: translateY(10rpx);
    opacity: 0.45;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.timeline-list::before {
  content: '';
  position: absolute;
  top: 14rpx;
  bottom: 28rpx;
  left: 0;
  width: 2rpx;
  background: var(--sc-timeline);
}

.timeline-entry {
  position: relative;
  margin-bottom: 36rpx;
  padding-left: 58rpx;
}

.timeline-rail {
  position: relative;
  display: flex;
  align-items: flex-start;
  height: 42rpx;
}

.timeline-rail text {
  color: var(--sc-muted);
  font-size: 20rpx;
  line-height: 30rpx;
}

.timeline-rail::before {
  content: '';
  position: absolute;
  top: 14rpx;
  left: -38rpx;
  width: 26rpx;
  height: 2rpx;
  background: var(--sc-timeline);
}

.timeline-dot {
  position: absolute;
  top: 6rpx;
  left: -66rpx;
  width: 18rpx;
  height: 18rpx;
  box-sizing: border-box;
  border: 3rpx solid var(--sc-action);
  border-radius: 50%;
  background: var(--sc-paper);
}

.paper-card {
  position: relative;
  display: block;
  width: 100%;
  min-height: 132rpx;
  box-sizing: border-box;
  padding: 22rpx 24rpx 18rpx;
  border: 1rpx solid var(--sc-line);
  border-radius: 14rpx;
  background: var(--sc-surface-soft);
  box-shadow: 0 4rpx 12rpx rgba(52, 66, 59, 0.05);
  text-align: left;
  transition:
    transform 0.16s cubic-bezier(0.2, 0.8, 0.2, 1),
    background-color 0.16s ease,
    box-shadow 0.16s ease;
}

.paper-card-pressed {
  background-color: var(--sc-selected-surface);
  transform: translateY(2rpx) scale(0.992);
  box-shadow: 0 2rpx 0 var(--sc-line-strong);
}

.paper-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.paper-content {
  display: block;
  margin: 0;
  padding-right: 8rpx;
  color: var(--sc-ink);
  font-size: 27rpx;
  line-height: 1.6;
}

.paper-meta {
  margin-top: 10rpx;
}

.paper-label {
  color: var(--sc-muted);
  font-size: 20rpx;
}

/* PRD：纸页右上角黄色折角表示当天仍有未解决问题。 */
.question-fold {
  position: absolute;
  top: 0;
  right: 0;
  width: 36rpx;
  height: 36rpx;
  border-radius: 0 14rpx 0 12rpx;
  background: linear-gradient(225deg, var(--sc-accent) 50%, transparent 50.5%);
}

/* Agent PRD：阅读与整理在同一张连续纸面上完成。 */
.paper-card.template-dot {
  background-color: var(--sc-paper);
  background-image: radial-gradient(rgba(158, 175, 162, 0.28) 1rpx, transparent 1rpx);
  background-size: 32rpx 32rpx;
}

.paper-card.template-rule {
  background-color: var(--sc-paper);
  background-image: repeating-linear-gradient(
    to bottom,
    transparent 0,
    transparent 41rpx,
    rgba(158, 175, 162, 0.28) 42rpx
  );
  background-size: 100% 42rpx;
}

.paper-card.template-rule::after {
  content: '';
  position: absolute;
  right: 0;
  bottom: 0;
  width: 30rpx;
  height: 30rpx;
  background: linear-gradient(135deg, transparent 48%, var(--sc-action-surface) 50%);
}

.paper-card.template-grid {
  background-color: var(--sc-paper);
  background-image:
    linear-gradient(rgba(158, 175, 162, 0.2) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(158, 175, 162, 0.2) 1rpx, transparent 1rpx);
  background-size: 36rpx 36rpx;
}

.paper-card.template-plain {
  background: linear-gradient(135deg, var(--sc-surface-soft), var(--sc-paper));
}

/* ---------- 状态与空态 ---------- */

.state-card,
.empty-day {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 480rpx;
  box-sizing: border-box;
  padding: 48rpx 24rpx;
  color: var(--sc-muted);
  font-size: 26rpx;
  text-align: center;
}

.empty-title {
  color: var(--sc-ink);
  font-size: 32rpx;
  font-weight: 600;
}

.empty-copy {
  max-width: 480rpx;
  margin-top: 14rpx;
  font-size: 25rpx;
  line-height: 1.6;
}

.state-card-error small {
  max-width: 520rpx;
  margin-top: 12rpx;
  color: var(--sc-muted-faint);
  font-size: 22rpx;
  line-height: 1.6;
  text-align: center;
}

.secondary-button,
.topic-submit {
  margin: 0;
  border-radius: 14rpx;
  font-size: 24rpx;
}

.secondary-button {
  min-height: 72rpx;
  margin-top: 28rpx;
  padding: 0 28rpx;
  border: 1rpx solid var(--sc-line);
  background: var(--sc-surface-soft);
  color: var(--sc-action);
  line-height: 2.5;
}/* ---------- 悬浮按钮 ---------- */

.fab {
  position: fixed;
  right: var(--sc-page-gutter, 32rpx);
  bottom: calc(32rpx + env(safe-area-inset-bottom));
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  min-width: 104rpx;
  max-width: 104rpx;
  height: 104rpx;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  border: 1rpx solid var(--sc-line-strong);
  border-radius: 50%;
  background: var(--sc-action-surface);
  color: var(--sc-action);
  box-shadow: 0 10rpx 28rpx rgba(52, 66, 59, 0.12);
  line-height: 1;
}

.plus-icon {
  width: 48rpx;
  height: 48rpx;
}

/* ---------- 抽屉 ---------- */
/* 契约：一列紧凑网格，所有次要值对齐同一条右缘。 */

.scrim {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  background-color: rgba(52, 66, 59, 0.6);
  background-color: var(--sc-scrim, rgba(52, 66, 59, 0.6));
}

.drawer {
  --drawer-gutter: 32rpx;
  --drawer-icon-column: 48rpx;
  --drawer-value-column: 80rpx;
  position: fixed;
  top: 0;
  bottom: 0;
  left: 0;
  right: auto;
  z-index: 21;
  box-sizing: border-box;
  width: 72vw;
  max-width: 560rpx;
  min-width: 0;
  padding: 104rpx var(--drawer-gutter) calc(36rpx + env(safe-area-inset-bottom));
  overflow-x: hidden;
  overflow-y: auto;
  overscroll-behavior: contain;
  background-color: #fffef9;
  background-color: var(--sc-paper, #fffef9);
  border-right: 1rpx solid var(--sc-line);
  box-shadow: 18rpx 0 42rpx rgba(43, 56, 48, 0.14);
  transform: translateX(-105%);
  transition: transform 0.24s cubic-bezier(0.2, 0.8, 0.2, 1);
}

.drawer-open {
  transform: translateX(0);
}

.drawer-profile {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 72rpx;
  margin: 0 0 20rpx;
  gap: 16rpx;
}

.drawer-profile-main {
  display: flex;
  flex: 1 1 auto;
  align-items: center;
  min-width: 0;
  gap: 16rpx;
}

.avatar {
  display: grid;
  flex: 0 0 72rpx;
  place-items: center;
  width: 72rpx;
  height: 72rpx;
  box-sizing: border-box;
  border: 4rpx solid var(--sc-ink, #34423b);
  border-radius: 50%;
  background: var(--sc-accent, #f1dc7a);
  color: var(--sc-ink, #34423b);
  font-family: Georgia, 'Songti SC', serif;
  font-size: 26rpx;
  font-style: italic;
  line-height: 1;
}

.profile-name {
  min-width: 0;
  overflow: hidden;
  color: var(--sc-ink);
  font-size: 26rpx;
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.drawer-profile-actions {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  min-width: 0;
  margin-left: auto;
  gap: 4rpx;
}

.drawer-icon-button {
  display: grid;
  flex: 0 0 64rpx;
  place-items: center;
  width: 64rpx;
  min-width: 64rpx;
  height: 88rpx;
  margin: 0;
  padding: 0;
  border-radius: 16rpx;
}

.drawer-action-icon {
  display: block;
  width: 32rpx;
  height: 32rpx;
}

/* ---------- 抽屉日历 ---------- */

.drawer-calendar {
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
}

.review-entry {
  display: flex !important;
  align-items: center;
  justify-content: space-between !important;
  width: 100%;
  height: 68rpx;
  min-height: 68rpx;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  background: transparent;
  color: var(--sc-muted);
  font-size: 22rpx;
  font-weight: 400;
  line-height: 1;
  text-align: left;
}

.review-entry .review-month,
.review-entry .review-binding {
  display: block;
  position: static;
  flex: 0 0 auto;
  margin: 0;
  padding: 0;
}

.review-entry .review-month {
  max-width: 280rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: center;
}

.review-month-group {
  display: flex;
  flex: 1 1 auto;
  align-items: center;
  justify-content: flex-start;
  min-width: 0;
  gap: 4rpx;
}

.month-shift-button {
  display: flex;
  flex: 0 0 48rpx;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
}

.month-shift-icon {
  display: block;
  width: 28rpx;
  height: 28rpx;
}

.review-entry .review-binding {
  display: flex;
  align-items: center;
  gap: 4rpx;
  color: var(--sc-muted);
  font-size: 22rpx;
  white-space: nowrap;
  text-align: right;
}

.review-entry .review-binding image {
  width: 24rpx;
  height: 24rpx;
}

/* 热力图：按周分行，每行 flex 平分 7 格。
   与首页周历条（week-days/week-day）同一布局模式——该模式已在真机验证；
   不用百分比宽度（button 上不生效）也不用 grid（repeat/place-items 不可靠）。 */
.calendar {
  width: 100%;
  margin-top: 8rpx;
}

.calendar-row {
  display: flex;
  flex-direction: row;
  width: 100%;
}

.calendar-weekday {
  display: flex;
  flex: 1 1 0;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 40rpx;
  box-sizing: border-box;
  color: var(--sc-muted);
  font-size: 20rpx;
  font-weight: 400;
  text-align: center;
}

.calendar-day {
  position: relative;
  display: flex;
  flex: 1 1 0;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 64rpx;
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  overflow: visible;
  border: 0;
  border-radius: 12rpx;
  background: transparent;
  color: transparent;
  font-size: 0;
  line-height: 1;
}

.calendar-day::after {
  display: none;
}

.calendar-day.is-blank {
  visibility: hidden;
}

.calendar-paper-icon {
  display: block;
  width: 32rpx;
  height: 40rpx;
}

.calendar-day.level-2 .calendar-paper-icon {
  filter: drop-shadow(-4rpx 4rpx 0 var(--sc-line-strong));
}

.calendar-day.level-3 .calendar-paper-icon {
  filter: drop-shadow(-4rpx 4rpx 0 var(--sc-line-strong)) drop-shadow(-8rpx 8rpx 0 var(--sc-timeline));
}

.calendar-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--sc-muted-faint);
}

.calendar-day.is-selected {
  outline: 3rpx solid var(--sc-action);
  outline-offset: 2rpx;
  background: var(--sc-selected-surface);
}

.heat-legend {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  width: 100%;
  min-height: 32rpx;
  margin: 10rpx 0 0;
  padding: 0;
  gap: 8rpx;
  color: var(--sc-muted);
  font-size: 22rpx;
}

.heat-legend-icon {
  display: block;
  flex: 0 0 auto;
}

.heat-legend-dot {
  width: 12rpx;
  height: 12rpx;
}

.heat-legend-paper {
  width: 18rpx;
  height: 22rpx;
}

.heat-legend-stack-2 {
  width: 20rpx;
  height: 24rpx;
}

.heat-legend-stack-3 {
  width: 22rpx;
  height: 26rpx;
}

/* ---------- 抽屉分区与列表 ---------- */
/* 抽屉列表采用紧凑节奏：同组行紧凑，分区之间保留清晰层级。 */

.drawer-section {
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
}

.drawer-topics-section,
.drawer-attention-section {
  margin-top: 8rpx;
}

.drawer-section-heading {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  max-width: 100%;
  min-height: 64rpx;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  color: var(--sc-muted);
  font-size: 22rpx;
  font-weight: 400;
}

.drawer-section-heading > text {
  flex: 1 1 auto;
  min-width: 0;
  text-align: left;
}

.attention-heading {
  margin-top: 8rpx;
}

.add-topic-button {
  display: flex;
  flex: 0 0 64rpx;
  align-items: center;
  justify-content: flex-end;
  width: 64rpx;
  min-width: 64rpx;
  height: 64rpx;
  margin: 0;
  padding: 0;
  border-radius: 14rpx;
  background: transparent;
  color: var(--sc-muted);
}

.add-topic-button image {
  width: 40rpx;
  height: 40rpx;
}

.topic-form {
  display: flex;
  align-items: center;
  width: 100%;
  margin: 4rpx 0 12rpx;
  gap: 12rpx;
}

.topic-input {
  flex: 1;
  min-width: 0;
  box-sizing: border-box;
  height: 72rpx;
  padding: 0 18rpx;
  border: 1rpx solid var(--sc-line);
  border-radius: 12rpx;
  background: var(--sc-surface-soft);
  font-size: 24rpx;
}

.topic-submit {
  width: 112rpx;
  height: 72rpx;
  padding: 0;
  background: var(--sc-action);
  color: var(--sc-paper);
}

.topic-list {
  width: 100%;
  max-width: 100%;
  margin-top: 4rpx;
}

.topic-empty {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  width: 100%;
  min-height: 120rpx;
  padding: 16rpx 0 8rpx;
  box-sizing: border-box;
  color: var(--sc-muted);
  font-size: 22rpx;
}

.topic-empty small {
  margin-top: 8rpx;
  color: var(--sc-muted-faint);
  font-size: 18rpx;
}

.topic-empty-button {
  min-height: 56rpx;
  margin-top: 16rpx;
  padding: 0 20rpx;
  border: 1rpx solid var(--sc-line);
  border-radius: 12rpx;
  background: var(--sc-action-surface);
  color: var(--sc-action);
  font-size: 20rpx;
}

.topic-overflow-button {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  width: 100%;
  min-height: 48rpx;
  margin: 0;
  padding: 0 0 0 60rpx;
  box-sizing: border-box;
  background: transparent;
  color: var(--sc-muted);
  font-size: 20rpx;
  font-weight: 400;
  text-align: left;
}/* ---------- 覆盖层：箱子、搜索、装订、问题 ---------- */

.overlay-panel {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 30;
  box-sizing: border-box;
  padding: 54rpx max(32rpx, env(safe-area-inset-right)) calc(40rpx + env(safe-area-inset-bottom))
    max(32rpx, env(safe-area-inset-left));
  overflow-y: auto;
  background-color: var(--sc-paper, #fffef9);
}

.search-panel,
.topics-panel {
  background-color: #fffef9;
  background-color: var(--sc-paper, #fffef9);
}

.topics-panel-list {
  width: 100%;
  margin-top: 24rpx;
}

.topics-panel-row {
  display: grid;
  grid-template-columns: 48rpx minmax(0, 1fr) 80rpx;
  align-items: center;
  width: 100%;
  min-height: 88rpx;
  margin: 0;
  padding: 0 8rpx;
  gap: 16rpx;
  box-sizing: border-box;
  border-bottom: 1rpx solid var(--sc-line);
  background: transparent;
  color: var(--sc-ink);
  font-size: 26rpx;
  text-align: left;
}

.topics-panel-row.is-selected {
  border-radius: 12rpx;
  background: var(--sc-action-surface-strong);
}

.topics-panel-icon {
  width: 40rpx;
  height: 40rpx;
}

.topics-panel-row > text {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.topics-panel-row > small {
  display: grid;
  place-items: center;
  justify-self: end;
  min-width: 40rpx;
  max-width: 80rpx;
  height: 40rpx;
  padding: 0 8rpx;
  overflow: hidden;
  box-sizing: border-box;
  border: 1rpx solid var(--sc-line-strong);
  border-radius: 20rpx;
  background: var(--sc-action-surface-strong);
  color: var(--sc-action);
  font-size: 22rpx;
  font-variant-numeric: tabular-nums;
  line-height: 1;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}.search-field-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  padding: 0 20rpx;
  border: 1rpx solid var(--sc-line);
  border-radius: 14rpx;
  background: var(--sc-surface-soft);
  font-size: 27rpx;
}

.clear-button {
  display: grid;
  place-items: center;
  width: auto;
  min-width: 88rpx;
  height: 88rpx;
  margin: 0;
  padding: 0 16rpx;
  background: transparent;
  color: var(--sc-muted);
  font-size: 24rpx;
}

.overlay-hint {
  display: block;
  margin: 48rpx 12rpx;
  color: var(--sc-muted);
  font-size: 25rpx;
}

.search-results {
  margin-top: 30rpx;
}

.search-result {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  width: 100%;
  min-height: 96rpx;
  margin-bottom: 0;
  padding: 24rpx 8rpx;
  border: 0;
  border-bottom: 1rpx solid var(--sc-line);
  border-radius: 0;
  background: transparent;
  text-align: left;
}

.result-title,
.result-detail {
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
}

.result-title {
  color: var(--sc-action);
  font-size: 24rpx;
  white-space: nowrap;
}

.result-detail {
  margin-top: 10rpx;
  color: var(--sc-ink);
  font-size: 26rpx;
  line-height: 1.5;
}

.problem-list {
  margin-top: 24rpx;
}

.overlay-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 420rpx;
  color: var(--sc-muted);
  font-size: 26rpx;
}

.overlay-empty small {
  margin-top: 18rpx;
  color: var(--sc-muted);
  font-size: 22rpx;
}

/* ---------- 月份装订 ---------- */

.bound-book {
  margin-top: 64rpx;
  padding: 54rpx 40rpx;
  border-radius: 22rpx;
  background-color: var(--sc-action, #53635a);
  color: var(--sc-paper);
  box-shadow: 0 16rpx 30rpx rgba(52, 66, 59, 0.16);
}

.book-kicker {
  display: block;
  color: var(--sc-accent);
  font-size: 20rpx;
  letter-spacing: 3rpx;
}

.book-title {
  display: block;
  margin-top: 42rpx;
  font-size: 52rpx;
  font-weight: 600;
}

.book-copy {
  display: block;
  margin-top: 28rpx;
  color: var(--sc-paper);
  opacity: 0.82;
  font-size: 27rpx;
  line-height: 1.7;
}

.review-stats {
  display: flex;
  align-items: center;
  justify-content: space-around;
  margin-top: 50rpx;
  text-align: center;
}

.review-stats view {
  display: flex;
  flex-direction: column;
}

.review-stats text {
  color: var(--sc-ink);
  font-size: 48rpx;
  font-weight: 600;
}

.review-stats small {
  margin-top: 8rpx;
  color: var(--sc-muted);
  font-size: 22rpx;
}

/* ---------- 纸页详情 ---------- */

.detail-panel {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 30;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background-color: #e8eee8;
  background-color: var(--sc-canvas, #e8eee8);
}

.detail-paper {
  flex: 0 1 auto;
  min-height: 540rpx;
  max-height: calc(100% - 360rpx);
  margin: 24rpx 28rpx 0;
  padding: 48rpx 44rpx 68rpx;
  overflow-y: auto;
  box-sizing: border-box;
  border: 1rpx solid var(--sc-line);
  border-radius: 20rpx 20rpx 0 0;
  background-color: var(--sc-paper);
  box-shadow: 0 10rpx 36rpx rgba(54, 68, 59, 0.06);
}

.detail-paper.has-photo {
  min-height: 820rpx;
}

.detail-paper.template-dot {
  background-image: radial-gradient(rgba(158, 175, 162, 0.3) 1rpx, transparent 1rpx);
  background-size: 44rpx 44rpx;
}

.detail-paper.template-plain {
  background-image: linear-gradient(135deg, rgba(220, 233, 216, 0.2), transparent 48%);
}

.detail-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 36rpx;
}

.detail-time {
  color: var(--sc-muted);
  font-size: 20rpx;
}

.detail-state {
  padding: 6rpx 14rpx;
  border: 1rpx solid var(--sc-line);
  border-radius: 12rpx;
  background: var(--sc-surface-warm);
  color: var(--sc-muted);
  font-size: 18rpx;
}

.detail-topic {
  display: inline-block;
  margin-bottom: 28rpx;
  padding: 8rpx 14rpx;
  border-radius: 12rpx;
  background: var(--sc-action-surface);
  color: var(--sc-action);
  font-size: 20rpx;
}

.detail-content {
  display: block;
  margin: 0;
  color: var(--sc-ink);
  font-size: 29rpx;
  line-height: 1.75;
  white-space: pre-wrap;
}

.detail-photo {
  display: block;
  width: 100%;
  max-height: 520rpx;
  margin-top: 28rpx;
  border-radius: 16rpx;
}

.detail-actions {
  display: flex;
  flex: 0 0 auto;
  gap: 18rpx;
  padding: 24rpx 40rpx calc(28rpx + env(safe-area-inset-bottom));
  background-color: #e8eee8;
  background-color: var(--sc-canvas, #e8eee8);
}

.understand-button {
  flex: 1;
  min-height: 92rpx;
  margin: 0;
  border: 1rpx solid var(--sc-line-strong);
  border-radius: 20rpx;
  background: var(--sc-action-surface);
  color: var(--sc-action);
  font-size: 24rpx;
}

/* ---------- 详情整理面板 ---------- */

.detail-manage-scrim {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 31;
  background-color: rgba(52, 66, 59, 0.6);
  background-color: var(--sc-scrim, rgba(52, 66, 59, 0.6));
}

.detail-manage-sheet {
  position: fixed;
  right: var(--sc-page-gutter, 32rpx);
  bottom: calc(var(--sc-page-gutter, 32rpx) + env(safe-area-inset-bottom));
  left: var(--sc-page-gutter, 32rpx);
  z-index: 32;
  padding: 16rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx;
  background: var(--sc-paper);
  box-shadow: 0 20rpx 60rpx rgba(44, 56, 48, 0.18);
}

.detail-manage-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  border-bottom: 1rpx solid var(--sc-line);
  color: var(--sc-ink);
  font-size: 26rpx;
  font-weight: 500;
}

.detail-manage-head button {
  min-width: 88rpx;
  min-height: 72rpx;
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  color: var(--sc-muted);
  font-size: 22rpx;
}

.manage-action {
  display: block;
  width: 100%;
  min-height: 116rpx;
  margin: 0;
  padding: 24rpx 8rpx;
  border: 0;
  border-bottom: 1rpx solid var(--sc-line);
  background: transparent;
  text-align: left;
}

.manage-action text,
.manage-action small {
  display: block;
}

.manage-action text {
  color: var(--sc-ink);
  font-size: 24rpx;
}

.manage-action small {
  margin-top: 8rpx;
  color: var(--sc-muted);
  font-size: 20rpx;
}

.detail-box-choices {
  max-height: 520rpx;
  overflow-y: auto;
}

.detail-box-choice {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-height: 88rpx;
  margin: 0;
  padding: 0 8rpx;
  border: 0;
  border-bottom: 1rpx solid var(--sc-line);
  background: transparent;
  color: var(--sc-ink);
  font-size: 24rpx;
  text-align: left;
}

.detail-box-choice small {
  color: var(--sc-muted);
  font-size: 20rpx;
}

/* ---------- AI 弄懂面板 ---------- */

.agent-panel {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 40;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background-color: #e8eee8;
  background-color: var(--sc-canvas, #e8eee8);
}

.agent-context {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-height: 76rpx;
  padding: 12rpx 40rpx;
  box-sizing: border-box;
  background: var(--sc-canvas);
}

.agent-context-topic {
  flex: 0 0 auto;
  padding: 6rpx 12rpx;
  border-radius: 10rpx;
  background: var(--sc-action-surface);
  color: var(--sc-action);
  font-size: 18rpx;
}

.agent-context-source {
  overflow: hidden;
  color: var(--sc-muted);
  font-size: 20rpx;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.agent-body {
  flex: 1;
  padding: 24rpx var(--sc-page-gutter, 32rpx) 48rpx;
  overflow: hidden;
}

.explain-deck {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 680rpx;
}

.explain-card {
  position: relative;
  width: 100%;
  min-height: 600rpx;
  box-sizing: border-box;
  padding: 54rpx 46rpx;
  border: 1rpx solid var(--sc-line);
  border-radius: 28rpx;
  background: var(--sc-paper);
  box-shadow: 0 16rpx 44rpx rgba(54, 68, 59, 0.08);
  transition:
    transform 0.22s cubic-bezier(0.2, 0.8, 0.2, 1),
    opacity 0.22s ease;
}

.agent-card-step {
  display: block;
  color: var(--sc-muted);
  font-size: 18rpx;
}

.explain-card-title {
  display: block;
  margin-top: 24rpx;
  color: var(--sc-ink);
  font-size: 32rpx;
  font-weight: 500;
  line-height: 1.5;
}

.explain-card-body {
  display: block;
  margin-top: 30rpx;
  color: var(--sc-ink);
  font-size: 24rpx;
  line-height: 1.85;
}

.explain-card-example {
  display: block;
  margin-top: 36rpx;
  padding-top: 26rpx;
  border-top: 1rpx solid var(--sc-line);
  color: var(--sc-muted);
  font-size: 22rpx;
  line-height: 1.7;
}

.swipe-guide {
  display: flex;
  justify-content: space-between;
  margin: 24rpx 12rpx 0;
  color: var(--sc-muted);
  font-size: 20rpx;
}

/* ---------- 动效偏好 ---------- */
/* PRD：减弱动态效果下解释卡只做 160ms 淡出。 */

@media (prefers-reduced-motion: reduce) {
  .timeline-swap,
  .drawer,
  .paper-card,
  .detail-manage-sheet {
    animation: none !important;
    transition: none !important;
  }

  .explain-card {
    transition: opacity 0.16s ease;
  }
}
