.page-shell {
  padding: 56rpx 40rpx;
}

.intro,
.empty-card {
  display: flex;
  flex-direction: column;
}

.eyebrow {
  color: #8a8b80;
  font-size: 22rpx;
  letter-spacing: 4rpx;
}

.title {
  margin-top: 20rpx;
  font-size: 56rpx;
  font-weight: 600;
}

.subtitle,
.empty-copy {
  margin-top: 16rpx;
  color: #77786d;
  font-size: 28rpx;
  line-height: 1.6;
}

.empty-card {
  margin-top: 80rpx;
  padding: 40rpx;
  border: 1rpx solid #dedbcc;
  border-radius: 24rpx;
  background: #fffdf7;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 600;
}

.primary-button {
  margin: 40rpx 0 0;
  border-radius: 16rpx;
  background: #68765f;
  color: #fffdf7;
  font-size: 30rpx;
}
