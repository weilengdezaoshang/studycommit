<scroll-view scroll-x class="strip"><view class="items"><view wx:for="{{images}}" wx:key="id" class="item"><button class="thumb {{selected === index ? 'selected' : ''}}" data-index="{{index}}" bindtap="select" aria-label="第 {{index + 1}} 张"><image wx:if="{{!item.missing}}" src="{{item.uri}}" mode="aspectFill" /><text wx:else>图片失效</text><text class="number">{{index + 1}}</text></button><button wx:if="{{removable}}" class="remove" data-id="{{item.id}}" bindtap="remove" aria-label="移除第 {{index + 1}} 张">移除</button></view></view></scroll-view>