<view class="hero"><text class="heading">{{title}}</text><view class="underline" /><text class="hint">完成后可编辑文字</text></view><notebook-sheet><view wx:for="{{rows}}" wx:key="id" class="task {{index > 0 ? 'divider' : ''}}"><image class="photo" src="{{item.uri}}" mode="aspectFill" /><view class="status">{{item.label === '已完成' ? '✓' : item.label === '识别中…' ? '✎' : item.label === '识别失败' ? '!' : '◷'}}</view><view class="copy"><text>第 {{index + 1}} 张</text><text class="hint">{{item.label}}</text></view><notebook-button wx:if="{{item.label === '识别失败'}}" label="重试" secondary data-id="{{item.id}}" bind:press="retry" /></view><text>已完成 {{completed}} / {{rows.length}} 张</text><view class="track" aria-label="已完成 {{completed}} / {{rows.length}} 张"><view class="bar" style="width:{{rows.length ? completed / rows.length * 100 : 0}}%" /></view></notebook-sheet>