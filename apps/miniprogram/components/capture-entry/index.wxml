<view wx:if="{{open}}" class="scrim" bindtap="close" aria-label="关闭创建菜单" /><view class="anchor"><block wx:if="{{open}}"><button class="circle action text" data-mode="text" aria-label="文字记录" bindtap="select">✎</button><button class="circle action ocr" data-mode="ocr" aria-label="识别文字" bindtap="select">⛶</button><button class="circle action image" data-mode="image" aria-label="图片记录" bindtap="select">▧</button></block><button class="circle" bindtap="toggle" aria-label="{{open ? '关闭创建菜单' : '新建记录'}}"><image src="{{open ? '/assets/icons/close.svg' : '/assets/icons/plus.svg'}}" mode="aspectFit" /></button></view>