/* 与 packages/design-tokens/src/colors.ts 中 studyCommitMistBlueColors 对齐（V7 雾蓝主题）。
   WXSS 不支持 :root 选择器，CSS 变量必须挂在 page 上才能生效。
   深色块按既有深色明度将色相从鼠尾草绿平移到雾蓝，深色板待设计确认后以共享 Token 为准。 */
page {
  --sc-ink: #303d50;
  --sc-muted: #59677b;
  --sc-muted-soft: #7c8797;
  --sc-muted-faint: #929bab;
  --sc-paper: #fffefc;
  --sc-canvas: #e9edf3;
  --sc-line: #d5dde8;
  --sc-accent: #d2e0f4;
  --sc-action: #4a6388;
  --sc-action-surface: #dce6f5;
  --sc-action-surface-strong: #cfddf0;
  --sc-selected-surface: #edf2fa;
  --sc-line-strong: #a6b8d2;
  --sc-timeline: #aab9cd;
  --sc-surface-soft: #f7f8fb;
  --sc-surface-warm: #f1f3f8;
  --sc-scrim: #303d5099;
  --sc-page-gutter: 32rpx;
  --sc-control-height: 88rpx;
}

@media (prefers-color-scheme: dark) {
  page {
    --sc-ink: #edf1f6;
    --sc-muted: #aeb9c7;
    --sc-muted-soft: #96a2b3;
    --sc-muted-faint: #7f8ca0;
    --sc-paper: #1a2130;
    --sc-canvas: #131a28;
    --sc-line: #3a4557;
    --sc-line-strong: #52627a;
    --sc-accent: #c6d6f0;
    --sc-action: #a9bcd8;
    --sc-action-surface: #29344a;
    --sc-action-surface-strong: #313e57;
    --sc-selected-surface: #2d3a52;
    --sc-surface-soft: #1e2736;
    --sc-surface-warm: #232d3f;
    --sc-timeline: #68768f;
    --sc-scrim: #05070db3;
  }
}
