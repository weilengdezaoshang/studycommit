{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["miniprogram-api-typings"],
    "allowJs": false,
    "baseUrl": ".",
    "paths": {
      "@studycommit/common/http": ["../../common/src/http/index.ts"],
      "@studycommit/observability": ["../../packages/observability/src/index.ts"],
      "@studycommit/rpc-contracts/papers": ["../../packages/rpc-contracts/src/papers.ts"]
    }
  },
  "include": ["**/*.ts", "types/**/*.d.ts"]
}
