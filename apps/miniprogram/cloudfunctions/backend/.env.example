# backend 云函数环境变量（占位示例，真实值只配置在微信云开发控制台）
# 密钥项（禁止提交真实值）：
INTERNAL_API_BASE_URL=https://api.example.com/api
INTERNAL_API_SIGNING_SECRET=replace-with-random-32-bytes-secret
# 非密钥项已内置在 config.json，可在控制台覆盖：
# INTERNAL_API_TIMEOUT_MS=10000
# CAPTURE_ENABLED=true
# IMAGE_RECORD_ENABLED=true
# MAX_CAPTURE_IMAGES=9
# FILE_MAX_BYTES=10485760
