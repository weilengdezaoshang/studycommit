{
  "name": "@studycommit/rpc-contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./auth": {
      "types": "./src/auth.ts",
      "default": "./dist/auth.js"
    },
    "./capture": {
      "types": "./src/capture.ts",
      "default": "./dist/capture.js"
    },
    "./contract": {
      "types": "./src/contract.ts",
      "default": "./dist/contract.js"
    },
    "./health": {
      "types": "./src/health.ts",
      "default": "./dist/health.js"
    },
    "./learning-records": {
      "types": "./src/learning-records.ts",
      "default": "./dist/learning-records.js"
    },
    "./papers": {
      "types": "./src/papers.ts",
      "default": "./dist/papers.js"
    },
    "./study-sessions": {
      "types": "./src/study-sessions.ts",
      "default": "./dist/study-sessions.js"
    },
    "./topics": {
      "types": "./src/topics.ts",
      "default": "./dist/topics.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@orpc/contract": "^1.15.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@orpc/openapi": "^1.15.0",
    "@orpc/zod": "^1.15.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10"
  }
}
